{
  "name": "pr-review-judgment",
  "version": "0.1.0",
  "private": true,
  "description": "Seeded PR review judgment study: a preregistered protocol experiment on whether automated reviewers localize seeded defects, falsely reject clean code, and what it costs. Offline Node CLI + static viewer. NOT MEASURED.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cli.json",
    "lint": "eslint .",
    "test": "vitest run",
    "replay": "tsx cli/replay.ts",
    "eval": "tsx cli/eval.ts",
    "corpus:verify": "tsx cli/corpus-verify.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
